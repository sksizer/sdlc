<%
/*
 * Eta template for a site roster page — the ONE roster family driven by
 * projection data ([[D-0010-deterministic-site-assembly]] §4, §6). Subsumes the
 * retired site_glossary_template.eta / site_references_template.eta: their
 * column variations are now projection data, not template forks.
 *
 * Fed by renderRosterPage in site/projections_render.ts via
 * renderSiteTemplate("site_roster_template", data).
 * Data shape (it.*):
 *   title            string    frontmatter title (verbatim)
 *   description      string    frontmatter description (verbatim)
 *   bannerSource     string    banner source path (e.g. "docs/planning/terms/")
 *   lead             string    lead paragraph under the banner (may be empty)
 *   headers          string[]  Active-table column headers
 *   activeRows       string[][] Active rows — cells per column, in header order
 *   followupRows     Array<{ cells: string[], status: string }>  non-active rows
 *   emptyPlaceholder string    rendered when there are no rows at all ("" → none)
 *
 * TypeScript owns ALL data derivation (sorting, bucketing, cell rendering);
 * this template owns ALL layout — table headers, separators, section heading,
 * placeholder, and conditional rendering.
 *
 * No trailing newline after the last table/placeholder — the content already
 * ends with "\n" from the table row or placeholder line.
 */
function pipeRow(cells) {
  return "| " + cells.join(" | ") + " |";
}
function sep(n) {
  var s = [];
  for (var i = 0; i < n; i++) s.push("---");
  return s;
}
function table(headers, rows) {
  var lines = [pipeRow(headers), pipeRow(sep(headers.length))];
  for (var i = 0; i < rows.length; i++) lines.push(pipeRow(rows[i]));
  return lines.join("\n") + "\n";
}
%>---
title: <%~ it.title %>
description: <%~ it.description %>
---

<!-- AUTO-GENERATED by `sdlc docs generate site` (solutions/ontological/lib/services/docs/site.ts) from <%~ it.bannerSource %>. Do not edit by hand. -->

<%~ it.lead ? it.lead + "\n\n" : "" %><%~ it.activeRows.length ? table(it.headers, it.activeRows) : "" %><%~ it.followupRows.length ? "\n**Emerging / retired:**\n\n" + table(it.headers.concat(["Status"]), it.followupRows.map(function(r){ return r.cells.concat([r.status]); })) : "" %><%~ (!it.activeRows.length && !it.followupRows.length && it.emptyPlaceholder) ? it.emptyPlaceholder + "\n" : "" %>