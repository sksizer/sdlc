/*
 * Eta template for <docs_site>/src/content/docs/roadmap.md — the generated Roadmap
 * page ([[D-0010-deterministic-site-assembly]] §5; [[T-9LHH-site-roadmap-generated]]).
 *
 * Fed by renderRoadmapPage in site/roadmap.ts via
 * renderSiteTemplate("site_roadmap_template", data).
 * Data shape (it.*):
 *   active    RoadmapRow[]  open/active milestones  (id/title/version/targetDate/summary)
 *   emerging  RoadmapRow[]  draft/planned/proposed  (same columns)
 *   shipped   ShippedRow[]  closed/* milestones     (id/title/version/shipped — completion note)
 *
 * RoadmapRow = { id, title, version, targetDate, summary }
 * ShippedRow = { id, title, version, shipped }
 *
 * The page is a STATIC direction-narrative preamble (owned by the generator —
 * the data-model-page precedent, hand-authored knowledge reviewed as code) plus
 * three milestone-derived tables. TypeScript owns ALL data derivation
 * (bucketing, version/target-date accessors, summary inlining); this template
 * owns ALL layout — the narrative prose and the tables. An empty bucket omits
 * its table entirely (empty-bucket tolerance).
 *
 * The file ends with a single trailing newline.
 */
function pipeRow(cells) {
  return "| " + cells.map(function (c) { return String(c == null ? "" : c); }).join(" | ") + " |";
}
function table(headers, rows) {
  var lines = [pipeRow(headers), pipeRow(headers.map(function () { return "---"; }))];
  for (var i = 0; i < rows.length; i++) lines.push(pipeRow(rows[i]));
  return lines.join("\n");
}
function milestoneTable(rows) {
  return table(
    ["Id", "Title", "Version", "Target date", "Summary"],
    rows.map(function (r) { return [r.id, r.title, r.version, r.targetDate, r.summary]; }),
  );
}
function shippedTable(rows) {
  return table(
    ["Id", "Title", "Version", "Shipped"],
    rows.map(function (r) { return [r.id, r.title, r.version, r.shipped]; }),
  );
}
