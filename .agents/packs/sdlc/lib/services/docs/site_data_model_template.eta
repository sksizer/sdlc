function pipeRow(cells) {
  return "| " + cells.join(" | ") + " |";
}
function table(headers, rows) {
  var sep = headers.map(function() { return "---"; });
  var lines = [pipeRow(headers), pipeRow(sep)];
  for (var i = 0; i < rows.length; i++) lines.push(pipeRow(rows[i]));
  return lines.join("\n");
}
