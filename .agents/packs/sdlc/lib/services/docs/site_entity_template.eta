<%
/*
 * Eta template for site reference/entities/<name>.md — one page per entity type.
 *
 * Fed by regenEntities in site.ts via renderSiteTemplate("site_entity_template", data).
 * The entity facts derive from the type's Zod schema in memory
 * (zodToJsonSchema), not the retired schema.json
 * ([[T-DHUF-entity-docs-migration-cleanup-ajv-removal]]). Data shape (it.*):
 *   title         string    e.g. "reference (entity)"
 *   fmDescription string    short page description, quotes escaped
 *   sourceRel     string    e.g. "solutions/ontological/lib/model/entities/reference/schema.ts"
 *   version       string    schema version string, or "" when absent
 *   overview      string    overview block text, or "" (empty now — the Zod
 *                           schemas carry no object-level description)
 *   props         Array<{ name, type, required, desc }> — property rows (may be [])
 *   enumFields    Array<{ name, values: string[] }> — enum fields (may be [])
 *
 * TypeScript owns data derivation; this template owns ALL layout.
 *
 * Note: no trailing newline in this template — the final ternary expression
 * already ends with "\n\n", matching the committed page byte-exactly.
 */
function propsTable(props) {
  var lines = ["| Field | Type | Required | Description |", "|---|---|---|---|"];
  for (var i = 0; i < props.length; i++) {
    var p = props[i];
    lines.push("| `" + p.name + "` | " + p.type + " | " + p.required + " | " + p.desc + " |");
  }
  return lines.join("\n") + "\n\n";
}
function enumsSection(enumFields) {
  var out = "## Enums\n\n";
  for (var i = 0; i < enumFields.length; i++) {
    var ef = enumFields[i];
    out += "### `" + ef.name + "`\n\n";
    for (var j = 0; j < ef.values.length; j++) {
      out += "- `" + ef.values[j] + "`\n";
    }
    out += "\n";
  }
  return out;
}
%>---
title: "<%~ it.title %>"
description: "<%~ it.fmDescription %>"
---

<!-- AUTO-GENERATED by `sdlc docs generate site` (solutions/ontological/lib/services/docs/site.ts) from <%~ it.sourceRel %>. Do not edit by hand. -->

_Generated from `<%~ it.sourceRel %>`._

<%~ it.version ? "_Schema version: " + it.version + "._\n\n" : "" %><%~ it.overview ? "## Description\n\n" + it.overview + "\n\n" : "" %><%~ it.props.length ? "## Properties\n\n" + propsTable(it.props) : "" %><%~ it.enumFields.length ? enumsSection(it.enumFields) : "" %>